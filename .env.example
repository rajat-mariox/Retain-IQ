NODE_ENV=development
PORT=3001
# Database-per-service: each service connects ONLY to its own database via its own
# DATABASE_URL. The value below is the default for core-api (identity). Each worker
# sets its own DATABASE_URL (see docker-compose.yml); per-service local values:
#   core-api (identity):        postgresql://identity:identity@localhost:5432/retainiq-identity?schema=public
#   events-worker (inbox):      postgresql://inbox:inbox@localhost:5433/retainiq-inbox?schema=public
#   analytics-worker:           postgresql://analytics:analytics@localhost:5434/retainiq-analytics?schema=public
#   notifications-service:       postgresql://notifications:notifications@localhost:5435/retainiq-notifications?schema=public
DATABASE_URL=postgresql://identity:identity@localhost:5432/retainiq-identity?schema=public
# core-api also reads the notifications DB read-only for the in-app inbox feed (BFF).
NOTIFICATIONS_DATABASE_URL=postgresql://notifications:notifications@localhost:5435/retainiq-notifications?schema=public
REDIS_URL=redis://localhost:6379
# Access and refresh secrets MUST differ. Replace before deploying.
JWT_ACCESS_SECRET=dev-access-secret-change-before-prod
JWT_REFRESH_SECRET=dev-refresh-secret-change-before-prod
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PERMISSION_CACHE_DRIVER=memory
AUTH_RATE_LIMIT=10
AUTH_RATE_TTL_SECONDS=60
# Event broker: "redis" (default, uses REDIS_URL) or "kafka".
BROKER_DRIVER=redis
# Required when BROKER_DRIVER=kafka (comma-separated). Host: localhost:29092
KAFKA_BROKERS=
LOG_LEVEL=info

# Platform (super-admin) auth. PLATFORM_JWT_SECRET must differ from the JWT_*
# secrets and must not be a placeholder in production. The email/password seed
# the first super admin on identity-service boot (only if it doesn't exist).
PLATFORM_JWT_SECRET=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Screenshot object storage. Locally a MinIO container provides S3 (these
# defaults match docker-compose). In production, leave S3_ENDPOINT unset to use
# real AWS S3 and provide IAM credentials + the bucket/region.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=retainiq-screenshots
# Host the browser/agent uses for presigned URLs (MinIO published port).
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Production (AWS S3) — leave S3_ENDPOINT empty, set these:
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
